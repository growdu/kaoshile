# 考试通知软件 - 环境变量样板
# 复制为 .env 并替换真实值（.env 已在 .gitignore）

APP_ENV=dev
APP_PORT=8000
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./data/app.db

# 鉴权：HMAC 签名密钥，至少 32 字节
# 生产请用：python -c "import secrets; print(secrets.token_urlsafe(48))"
LINK_SECRET=__generate_random_32_bytes__

# 管理员后台
MANAGE_USERNAME=admin
# 用：python -c "import bcrypt; print(bcrypt.hashpw(b'change-me', bcrypt.gensalt()).decode())"
MANAGE_PASSWORD_HASH=__bcrypt_hash__

# 阿里云（v1 留空则启用 Mock 通道；生产必填）
ALIYUN_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 日志
LOG_LEVEL=INFO

# 通知策略
VERIFICATION_WARN_DAYS=30
VERIFICATION_EXPIRE_DAYS=90
